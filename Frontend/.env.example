# Required. Base URL of the RouteAI backend, including the API version prefix.
# The app throws at startup if this is unset — there is no fallback in code.
#
# Which file wins:
#   .env             all modes (local development and tests)  -> localhost
#   .env.production  `npm run build` only                      -> hosted backend
#   .env.local       your machine only, git-ignored, overrides both
VITE_API_BASE_URL=http://localhost:3000/api/v1
